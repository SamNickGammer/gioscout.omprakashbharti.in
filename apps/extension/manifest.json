{
  "manifest_version": 3,
  "name": "GeoScout — Maps Lead Scanner",
  "version": "0.1.0",
  "description": "Auto-scrapes Google Maps search results into your GeoScout lead database, deduped by Place ID.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://www.google.com/maps/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GeoScout",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
