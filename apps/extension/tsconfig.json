{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["chrome"],
    "paths": {
      "@geoscout/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "build.mjs"]
}
