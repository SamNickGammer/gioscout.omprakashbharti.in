# ─────────────────────────────────────────────────────────────
# GeoScout environment variables
# Copy to apps/web/.env.local for local dev, and set the same in
# Vercel project settings for production.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — pooled connection string (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/geoscout?sslmode=require"

# Auth — single user. Generate a hash with: yarn workspace @geoscout/web auth:hash "your-password"
JWT_SECRET="change-me-to-a-long-random-string"
AUTH_EMAIL="you@example.com"
AUTH_PASSWORD_HASH="$2a$10$replace-with-a-real-bcrypt-hash"

# Shared secret the Chrome extension sends as `x-api-key` on /api/ingest
INGEST_API_KEY="change-me-to-a-long-random-string"

# Cloudflare R2 (S3-compatible) — for lead file attachments
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="geoscout"
# Public base URL of the bucket (R2 public dev URL or custom domain)
R2_PUBLIC_URL=""

# Public base URL of the deployed app (used by the extension default + links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
