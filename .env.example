# ─────────────────────────────────────────────────────────────
# GeoScout environment variables
# Copy to apps/web/.env.local for local dev, and set the same in
# Vercel project settings for production.
# ─────────────────────────────────────────────────────────────

# Supabase Postgres — the DIRECT connection string (Project Settings →
# Database → Connection string → URI). Includes your DB password.
# Use the pooler URI for serverless; the driver sets prepare:false for pgBouncer.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Supabase project URL + publishable (anon) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Service-role key (SERVER ONLY — never expose). Needed for file storage.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="geoscout"

# Auth — multi-user (DB-backed). Only the JWT signing secret lives in env.
# Users live in the `users` table; create the first admin with:
#   yarn workspace @geoscout/web user:add admin@example.com "Admin" "password" admin
# Each user gets a personal extension API key (shown on their Settings page).
JWT_SECRET="change-me-to-a-long-random-string"

# Public base URL of the deployed app (used by the extension default + links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
